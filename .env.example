# PFN runs with zero configuration. Everything below is optional: copy this
# file to `.env` only if you need to change something.

# --- Where the data lives --------------------------------------------------
# SQLite database file, created on first start. Default:
#   Windows  %APPDATA%\PFN\pfn.db
#   macOS    ~/Library/Application Support/PFN/pfn.db
#   Linux    ~/.local/share/PFN/pfn.db
# PFN_DATA_DIR=C:\Users\me\Documents\PFN

# --- Server ----------------------------------------------------------------
# PFN_HOST=127.0.0.1
# PFN_PORT=8765
# PFN_OPEN_BROWSER=true

# --- Optional integrations -------------------------------------------------
# Free CoinGecko Demo key: without it the Crypto tab shows a clear error and
# every other screen works offline.
# PFN_COINGECKO_API_KEY=

# --- Postgres instead of SQLite (optional) ---------------------------------
# PFN_DB_BACKEND=postgres
# PFN_POSTGRES_USER=pfn
# PFN_POSTGRES_PASSWORD=
# PFN_POSTGRES_DB=pfn
# PFN_POSTGRES_HOST=localhost
# PFN_POSTGRES_PORT=5432

# --- Misc ------------------------------------------------------------------
# PFN_DEFAULT_CURRENCY=USD
# PFN_ENABLE_DOCS=true
# Only needed if the UI is served from a different origin than the API.
# PFN_CORS_ORIGINS=
